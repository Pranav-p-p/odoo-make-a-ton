# Copy to .env.local and fill in. Never commit .env.local. The lead shares the real values privately.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
# Server only: signup, staff invites and the seed script. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=<service role key>
# Invoice emails (D-28). Without a key, "Send" writes email_log status 'skipped' and says so.
RESEND_API_KEY=
EMAIL_FROM="Brightloop Billing <onboarding@resend.dev>"
# Used in auth and invoice email links.
APP_URL=http://localhost:3000
